DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Data provider base URLs
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=your_demo_api_key_here
ALTERNATIVE_ME_BASE_URL=https://api.alternative.me
COINLORE_BASE_URL=https://api.coinlore.net/api
CMC_BASE_URL=https://pro-api.coinmarketcap.com

# Hyperliquid
HYPERLIQUID_TESTNET=true

# === ArangoDB (Graph Memory + risk thresholds) ===
ARANGO_URL=http://127.0.0.1:8529
ARANGO_DB=odin
ARANGO_USER=root
ARANGO_PASSWORD=

# === DeepSeek thinking mode (Planning Agent) ===
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_PLANNING_MODEL=deepseek-v4-pro

# === Exa web search (Planning Agent, optional — web_search tool degrades gracefully without it) ===
EXA_API_KEY=

# === Risk engine defaults (fallback when user has no risk_thresholds in ArangoDB) ===
RISK_CONFIDENCE_THRESHOLD=70
RISK_MAX_POSITION_USDC=100
RISK_MAX_LEVERAGE=10
RISK_PER_TRADE_PERCENT=1

# === ATR-based SL/TP (Planning Agent risk engine) ===
ATR_PERIOD=14
ATR_CANDLE_INTERVAL=1h
ATR_CANDLE_COUNT=20
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0

# === Self-consistency timeout ===
SELF_CONSISTENCY_TIMEOUT_MS=30000

# === Execution Agent (Hyperliquid Exchange) ===
MASTER_PRIVATE_KEY=0x...
AGENT_PRIVATE_KEY=0x...
AGENT_WALLET_ADDRESS=0x...

# === Fill monitoring ===
EXECUTION_FILL_TIMEOUT_MS=15000
EXECUTION_POLL_INTERVAL_MS=2000
EXECUTION_POLL_MAX_ATTEMPTS=8

# === Binance Futures (fallback data source) ===
BINANCE_FAPI_BASE_URL=https://fapi.binance.com/fapi/v1
