{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "arangodb": {
            "type": "local",
            "command": [
                "docker",
                "run",
                "-i",
                "--rm",
                "-e",
                "ARANGO_HOSTS=http://host.docker.internal:8529",
                "-e",
                "ARANGO_ROOT_USERNAME=root",
                "-e",
                "ARANGO_ROOT_PASSWORD=password123",
                "-e",
                "ARANGO_DEFAULT_DB_NAME=odin",
                "-e",
                "ARANGO_VERIFY_SSL=false",
                "arangodb/mcp-arangodb:latest"
            ],
            "enabled": true
        },
        "hyperliquid": {
            "type": "local",
            "command": [
                "uvx",
                "--from",
                "mcp-hyperliquid",
                "hyperliquid-mcp"
            ],
            "environment": {
                "HYPERLIQUID_PRIVATE_KEY": "0x2faedcd0c3977a7e18dcfa3372df8fa92dac7e43599642902d08ab7b5fd22e39",
                "HYPERLIQUID_TESTNET": "true"
            },
            "enabled": true
        }
    }
}